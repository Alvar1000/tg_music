# Скопируй этот файл в .env и заполни значения.
# cp .env.example .env

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Канал, на который проверяется подписка.
# Можно указать @username или числовой id вида -1001234567890.
CHANNEL_ID=@blackmagicwoman

# Ссылка на канал — кнопка «Подписаться» на экране-гейте.
CHANNEL_URL=https://t.me/blackmagicwoman

# Ссылка на чат сообщества — кнопка в разделе «Общение».
COMMUNITY_CHAT_URL=

# Ссылка на плейлист дня в Яндекс.Музыке — раздел «Плейлист дня».
YANDEX_PLAYLIST_URL=

# Telegram id админов через запятую (свой id узнать у @userinfobot).
# Пример: ADMIN_IDS=12345678,87654321
ADMIN_IDS=

# Когда факты у пользователя закончились: true — начинать круг заново,
# false — показать сообщение «факты закончились».
RESET_FACTS_WHEN_DONE=false

# Картинка-баннер над главным меню (необязательно): путь к файлу или URL.
# Если пусто — бот ищет content/menu.jpg (или menu.png/menu.jpeg/menu.webp).
# Нет картинки — меню просто текстовое.
MENU_IMAGE=

# (необязательно) пути к базе и логам. По умолчанию bot.db и bot.log рядом с main.py.
# На хостинге с постоянным диском укажи путь на диске (Render: /data/bot.db),
# чтобы база переживала редеплой.
# DB_PATH=bot.db
# LOG_FILE=bot.log

# (необязательно) очередь «плейлиста дня». По умолчанию content/playlists.json.
# На хостинге с постоянным диском укажи путь на диске, чтобы загрузки плейлистов
# через бота переживали передеплой. Пример для Render:
# PLAYLISTS_PATH=/data/playlists.json

# (необязательно) публичный HTTPS-адрес мини-игры «Найди группу» (без / на конце).
# На Render подставляется сам через RENDER_EXTERNAL_URL — трогать не нужно.
# Для локальной разработки укажи туннель (например, ngrok), иначе кнопка мини-игры
# в разделе «Тесты» просто не покажется — Telegram Mini App требует HTTPS.
# WEBAPP_URL=https://example.ngrok-free.app

# (необязательно) порт aiohttp-сервера мини-игры. На Render подставляется сам через PORT.
# PORT=8080
